# DB
POSTGRES_USER=label
POSTGRES_PASSWORD=label
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=label

# Auth
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://lustdsox.github.io

# Storage: local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=/tmp/label_uploads

# Auto-publish loop
AUTO_PUBLISH_LOOP=1
AUTO_PUBLISH_INTERVAL_SEC=900
CRON_SECRET=change-me

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
